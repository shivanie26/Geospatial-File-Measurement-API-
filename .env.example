# Copy to .env to override defaults. Every variable is optional.
# Variables are read with the GEO_ prefix.

GEO_STORAGE_DIR=storage

# Upload and processing limits
# 50 MiB per uploaded file
GEO_MAX_UPLOAD_BYTES=52428800
# 250 MiB total after unzipping
GEO_MAX_ARCHIVE_UNCOMPRESSED_BYTES=262144000
GEO_MAX_ARCHIVE_ENTRIES=500
GEO_MAX_ARCHIVE_COMPRESSION_RATIO=200
GEO_MAX_FEATURES=50000

# Pagination for GET /api/files/{id}/measurements/
GEO_DEFAULT_PAGE_SIZE=100
GEO_MAX_PAGE_SIZE=1000

# Leave empty so datasets WITHOUT a CRS are never measured.
# Set e.g. EPSG:4326 only if you knowingly want to assume a CRS; every such
# assumption is flagged in the API response.
GEO_ASSUME_CRS_IF_MISSING=

GEO_LOG_LEVEL=INFO
